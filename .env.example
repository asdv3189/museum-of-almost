# Defaults are local-only. Copy to .env.local. Never commit secrets.
MUSEUM_STORAGE=local
# The following are required only after creating an actual Sanity project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Server-only read-only token, REQUIRED even for a public dataset: namespaced IDs
# contain dots and Sanity excludes those IDs from unauthenticated public reads.
SANITY_READ_TOKEN=
# Separate minimally scoped content Editor token. Never use NEXT_PUBLIC_* for tokens.
SANITY_WRITE_TOKEN=
# Explicit opt-in for cloud writes; false by default.
SANITY_WRITE_ENABLED=false
# Long random secret for the curator gateway. Never send it in a URL.
MUSEUM_CURATOR_KEY=
# Studio only uses non-secret project metadata.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
